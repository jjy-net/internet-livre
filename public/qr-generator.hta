<!DOCTYPE html>
<html>
<head>
<title>Gerador de QR Code Offline</title>
<HTA:APPLICATION 
    ID="QRCodeApp"
    APPLICATIONNAME="Gerador de QR Code Offline"
    BORDER="thin"
    CAPTION="yes"
    ICON="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='15' fill='%237c3aed'/%3E%3Cg fill='white'%3E%3Crect x='15' y='15' width='25' height='25' rx='3'/%3E%3Crect x='60' y='15' width='25' height='25' rx='3'/%3E%3Crect x='15' y='60' width='25' height='25' rx='3'/%3E%3Crect x='60' y='60' width='8' height='8'/%3E%3Crect x='72' y='60' width='8' height='8'/%3E%3Crect x='60' y='72' width='8' height='8'/%3E%3Crect x='72' y='72' width='13' height='13'/%3E%3C/g%3E%3C/svg%3E"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
    SCROLLFLAT="yes"
    VERSION="1.0"
    INNERBORDER="no"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    NAVIGABLE="no"
    CONTEXTMENU="no"
    SELECTION="no"
/>
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<meta charset="UTF-8">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    color: #fff;
    height: 100vh;
    overflow: hidden;
}
.app { display: flex; flex-direction: column; height: 100vh; }
.header {
    background: rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    backdrop-filter: blur(10px);
}
.logo { display: flex; align-items: center; gap: 12px; }
.logo-icon {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
}
.logo-text h1 { font-size: 16px; font-weight: 600; }
.logo-text p { font-size: 11px; color: #a0a0a0; }
.badge {
    padding: 4px 10px;
    background: rgba(34,197,94,0.2);
    color: #4ade80;
    border: 1px solid rgba(34,197,94,0.3);
    border-radius: 20px;
    font-size: 11px;
}
.main {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 16px;
    overflow: hidden;
}
.panel {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 16px;
    overflow-y: auto;
    backdrop-filter: blur(10px);
}
.panel::-webkit-scrollbar { width: 8px; }
.panel::-webkit-scrollbar-track { background: transparent; }
.panel::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
.section-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #c4b5fd;
}
.textarea-wrap { position: relative; }
textarea {
    width: 100%;
    height: 120px;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 10px;
    color: #fff;
    font-family: 'Consolas', monospace;
    font-size: 12px;
    resize: none;
    outline: none;
}
textarea:focus { border-color: #7c3aed; box-shadow: 0 0 0 2px rgba(124,58,237,0.3); }
.char-count {
    position: absolute;
    bottom: 8px;
    right: 10px;
    font-size: 10px;
    color: #666;
}
.btn-row { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
.btn {
    padding: 6px 12px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 6px;
    color: #ddd;
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s;
}
.btn:hover { background: rgba(255,255,255,0.15); }
.btn-primary {
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    border-color: transparent;
    color: #fff;
    font-weight: 500;
}
.btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
.settings { margin-top: 14px; }
.setting-group { margin-bottom: 12px; }
.setting-label {
    font-size: 11px;
    color: #a0a0a0;
    margin-bottom: 6px;
    display: block;
}
.ec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.ec-btn {
    padding: 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
    color: #fff;
    transition: all 0.2s;
}
.ec-btn:hover { background: rgba(255,255,255,0.1); }
.ec-btn.active {
    background: rgba(124,58,237,0.2);
    border-color: #7c3aed;
    box-shadow: 0 0 0 1px rgba(124,58,237,0.3);
}
.ec-btn .level { font-size: 12px; font-weight: 600; }
.ec-btn .desc { font-size: 10px; color: #888; margin-top: 2px; }
.slider-wrap { display: flex; align-items: center; gap: 10px; }
input[type="range"] {
    flex: 1;
    height: 4px;
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
    outline: none;
    -webkit-appearance: none;
}
input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px; height: 14px;
    background: #7c3aed;
    border-radius: 50%;
    cursor: pointer;
}
.slider-value { font-size: 11px; color: #c4b5fd; min-width: 50px; text-align: right; }
.color-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.color-input {
    display: flex; align-items: center; gap: 6px;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    padding: 4px 8px;
}
input[type="color"] {
    width: 28px; height: 28px;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 4px;
}
.color-hex {
    font-size: 11px;
    font-family: monospace;
    color: #ccc;
    flex: 1;
    background: transparent;
    border: none;
    color: #ccc;
    outline: none;
}
.templates { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 10px; }
.template-btn {
    padding: 10px 6px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    cursor: pointer;
    text-align: center;
    color: #fff;
    transition: all 0.2s;
}
.template-btn:hover { background: rgba(255,255,255,0.1); transform: translateY(-1px); }
.template-btn .icon { font-size: 18px; }
.template-btn .label { font-size: 10px; color: #888; margin-top: 3px; }
.qr-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
}
.qr-container {
    background: #fff;
    border-radius: 12px;
    padding: 16px;
    box-shadow: 0 20px 60px rgba(124,58,237,0.2);
    display: inline-block;
}
#qr-canvas { display: block; }
.empty-state {
    text-align: center;
    color: #555;
    padding: 40px 20px;
}
.empty-state .icon { font-size: 48px; opacity: 0.3; margin-bottom: 12px; }
.empty-state p { font-size: 12px; }
.empty-state .hint { font-size: 10px; color: #444; margin-top: 6px; }
.action-buttons {
    display: flex;
    gap: 6px;
    margin-top: 16px;
    flex-wrap: wrap;
    justify-content: center;
}
.info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 14px;
}
.info-item {
    background: rgba(0,0,0,0.2);
    border-radius: 8px;
    padding: 10px;
}
.info-item .label { font-size: 10px; color: #666; }
.info-item .value { font-size: 12px; font-weight: 500; margin-top: 2px; }
.themes { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }
.theme-btn {
    padding: 4px 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px;
    cursor: pointer;
    font-size: 10px;
    color: #ccc;
    display: flex;
    align-items: center;
    gap: 4px;
}
.theme-btn:hover { background: rgba(255,255,255,0.1); }
.theme-preview {
    width: 12px; height: 12px;
    border-radius: 2px;
    border: 1px solid rgba(255,255,255,0.2);
}
</style>
</head>
<body>
<div class="app">
    <div class="header">
        <div class="logo">
            <div class="logo-icon">⬛</div>
            <div class="logo-text">
                <h1>Gerador de QR Code</h1>
                <p>100% Offline - Sem Internet</p>
            </div>
        </div>
        <div class="badge">● Offline Seguro</div>
    </div>
    
    <div class="main">
        <div class="panel">
            <div class="section-title">📝 Conteúdo</div>
            <div class="textarea-wrap">
                <textarea id="content" placeholder="Cole ou digite: texto, URL, senha, e-mail, Wi-Fi..."></textarea>
                <div class="char-count"><span id="char-count">0</span> caracteres</div>
            </div>
            <div class="btn-row">
                <button class="btn" onclick="clearContent()">🗑️ Limpar</button>
                <button class="btn" onclick="pasteFromClipboard()">📋 Colar</button>
                <button class="btn btn-primary" onclick="generateQR()">⚡ Gerar QR</button>
            </div>

            <div class="settings">
                <div class="section-title">⚙️ Correção de Erro</div>
                <div class="ec-grid">
                    <div class="ec-btn" data-level="L" onclick="setECLevel('L')">
                        <div class="level">Baixa (L)</div>
                        <div class="desc">~7% recuperação</div>
                    </div>
                    <div class="ec-btn active" data-level="M" onclick="setECLevel('M')">
                        <div class="level">Média (M)</div>
                        <div class="desc">~15% recuperação</div>
                    </div>
                    <div class="ec-btn" data-level="Q" onclick="setECLevel('Q')">
                        <div class="level">Quartil (Q)</div>
                        <div class="desc">~25% recuperação</div>
                    </div>
                    <div class="ec-btn" data-level="H" onclick="setECLevel('H')">
                        <div class="level">Alta (H)</div>
                        <div class="desc">~30% recuperação</div>
                    </div>
                </div>

                <div class="setting-group" style="margin-top:12px">
                    <label class="setting-label">Tamanho: <span id="size-value">300</span>px</label>
                    <div class="slider-wrap">
                        <input type="range" id="size-slider" min="150" max="600" value="300" step="25" oninput="updateSize()">
                    </div>
                </div>

                <div class="setting-group">
                    <label class="setting-label">Margem: <span id="margin-value">4</span></label>
                    <div class="slider-wrap">
                        <input type="range" id="margin-slider" min="0" max="10" value="4" step="1" oninput="updateMargin()">
                    </div>
                </div>

                <div class="setting-group">
                    <label class="setting-label">Cores</label>
                    <div class="color-row">
                        <div class="color-input">
                            <input type="color" id="dark-color" value="#000000" onchange="updateColors()">
                            <input type="text" class="color-hex" id="dark-hex" value="#000000" onchange="updateDarkHex()">
                        </div>
                        <div class="color-input">
                            <input type="color" id="light-color" value="#ffffff" onchange="updateColors()">
                            <input type="text" class="color-hex" id="light-hex" value="#ffffff" onchange="updateLightHex()">
                        </div>
                    </div>
                    <div class="themes">
                        <div class="theme-btn" onclick="applyTheme('#000000','#ffffff')"><div class="theme-preview" style="background:linear-gradient(135deg,#000 50%,#fff 50%)"></div>Clássico</div>
                        <div class="theme-btn" onclick="applyTheme('#1a1a2e','#e0e0e0')"><div class="theme-preview" style="background:linear-gradient(135deg,#1a1a2e 50%,#e0e0e0 50%)"></div>Elegante</div>
                        <div class="theme-btn" onclick="applyTheme('#2d1b69','#f0e6ff')"><div class="theme-preview" style="background:linear-gradient(135deg,#2d1b69 50%,#f0e6ff 50%)"></div>Roxo</div>
                        <div class="theme-btn" onclick="applyTheme('#004d40','#e0f2f1')"><div class="theme-preview" style="background:linear-gradient(135deg,#004d40 50%,#e0f2f1 50%)"></div>Verde</div>
                        <div class="theme-btn" onclick="applyTheme('#b71c1c','#ffebee')"><div class="theme-preview" style="background:linear-gradient(135deg,#b71c1c 50%,#ffebee 50%)"></div>Vermelho</div>
                        <div class="theme-btn" onclick="applyTheme('#0d47a1','#e3f2fd')"><div class="theme-preview" style="background:linear-gradient(135deg,#0d47a1 50%,#e3f2fd 50%)"></div>Azul</div>
                        <div class="theme-btn" onclick="applyTheme('#ffffff','#1a1a1a')"><div class="theme-preview" style="background:linear-gradient(135deg,#fff 50%,#1a1a1a 50%)"></div>Invertido</div>
                    </div>
                </div>
            </div>

            <div class="section-title" style="margin-top:14px">📋 Modelos Rápidos</div>
            <div class="templates">
                <div class="template-btn" onclick="applyTemplate('url')"><div class="icon">🔗</div><div class="label">URL</div></div>
                <div class="template-btn" onclick="applyTemplate('wifi')"><div class="icon">📶</div><div class="label">Wi-Fi</div></div>
                <div class="template-btn" onclick="applyTemplate('email')"><div class="icon">📧</div><div class="label">E-mail</div></div>
                <div class="template-btn" onclick="applyTemplate('phone')"><div class="icon">📱</div><div class="label">Telefone</div></div>
                <div class="template-btn" onclick="applyTemplate('vcard')"><div class="icon">👤</div><div class="label">Contato</div></div>
                <div class="template-btn" onclick="applyTemplate('sms')"><div class="icon">💬</div><div class="label">SMS</div></div>
            </div>
        </div>

        <div class="panel">
            <div class="section-title">📱 QR Code Gerado</div>
            <div class="qr-display">
                <div id="qr-area">
                    <div class="empty-state">
                        <div class="icon">⬛</div>
                        <p>Digite ou cole algo para gerar o QR Code</p>
                        <p class="hint">Ctrl+V para colar rapidamente</p>
                    </div>
                </div>
            </div>
            <div class="action-buttons" id="action-buttons" style="display:none">
                <button class="btn btn-primary" onclick="downloadQR()">💾 Salvar PNG</button>
                <button class="btn" onclick="copyQR()">📋 Copiar Imagem</button>
            </div>
            <div class="info-grid" id="info-grid" style="display:none">
                <div class="info-item"><div class="label">Correção</div><div class="value" id="info-ec">Média (M)</div></div>
                <div class="info-item"><div class="label">Tamanho</div><div class="value" id="info-size">300×300</div></div>
                <div class="info-item"><div class="label">Caracteres</div><div class="value" id="info-chars">0</div></div>
                <div class="info-item"><div class="label">Proteção</div><div class="value" id="info-protection">15%</div></div>
            </div>
        </div>
    </div>
</div>

<script>
// QR Code Generator - Implementação pura em JavaScript
// Baseado no algoritmo de QR Code (ISO/IEC 18004)
var QRCodeLib = (function() {
    // Tabela de capacidade e correção de erro
    var EC_LEVELS = { L: 1, M: 0, Q: 3, H: 2 };
    
    // Simplified QR generation using canvas
    function generate(text, options) {
        options = options || {};
        var ecLevel = options.ecLevel || 'M';
        var size = options.size || 300;
        var margin = options.margin !== undefined ? options.margin : 4;
        var darkColor = options.darkColor || '#000000';
        var lightColor = options.lightColor || '#ffffff';
        
        // Usar a biblioteca qrcode embutida
        var matrix = createQRMatrix(text, ecLevel);
        if (!matrix) return null;
        
        var moduleCount = matrix.length;
        var moduleSize = size / (moduleCount + margin * 2);
        
        var canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        var ctx = canvas.getContext('2d');
        
        // Fundo
        ctx.fillStyle = lightColor;
        ctx.fillRect(0, 0, size, size);
        
        // Módulos
        ctx.fillStyle = darkColor;
        for (var row = 0; row < moduleCount; row++) {
            for (var col = 0; col < moduleCount; col++) {
                if (matrix[row][col]) {
                    var x = (col + margin) * moduleSize;
                    var y = (row + margin) * moduleSize;
                    ctx.fillRect(Math.round(x), Math.round(y), Math.ceil(moduleSize), Math.ceil(moduleSize));
                }
            }
        }
        
        return canvas;
    }
    
    // Implementação simplificada do algoritmo QR
    function createQRMatrix(text, ecLevel) {
        // Converter texto para bytes
        var bytes = [];
        for (var i = 0; i < text.length; i++) {
            var code = text.charCodeAt(i);
            if (code < 128) {
                bytes.push(code);
            } else if (code < 2048) {
                bytes.push(192 | (code >> 6));
                bytes.push(128 | (code & 63));
            } else {
                bytes.push(224 | (code >> 12));
                bytes.push(128 | ((code >> 6) & 63));
                bytes.push(128 | (code & 63));
            }
        }
        
        // Determinar versão (tamanho) baseada no conteúdo
        var version = getMinVersion(bytes.length, ecLevel);
        if (version < 1) version = 1;
        if (version > 40) version = 40;
        
        var size = version * 4 + 17;
        var matrix = [];
        for (var i = 0; i < size; i++) {
            matrix[i] = [];
            for (var j = 0; j < size; j++) {
                matrix[i][j] = null;
            }
        }
        
        // Adicionar finder patterns
        addFinderPattern(matrix, 0, 0);
        addFinderPattern(matrix, size - 7, 0);
        addFinderPattern(matrix, 0, size - 7);
        
        // Adicionar alignment patterns (para versão >= 2)
        if (version >= 2) {
            var positions = getAlignmentPositions(version);
            for (var i = 0; i < positions.length; i++) {
                for (var j = 0; j < positions.length; j++) {
                    var row = positions[i];
                    var col = positions[j];
                    if (matrix[row][col] === null) {
                        addAlignmentPattern(matrix, row, col);
                    }
                }
            }
        }
        
        // Adicionar timing patterns
        for (var i = 8; i < size - 8; i++) {
            matrix[6][i] = (i % 2 === 0) ? 1 : 0;
            matrix[i][6] = (i % 2 === 0) ? 1 : 0;
        }
        
        // Dark module
        matrix[size - 8][8] = 1;
        
        // Reservar áreas de formato e versão
        reserveFormatArea(matrix, size);
        
        // Codificar dados
        var dataBits = encodeData(bytes, version, ecLevel);
        
        // Colocar dados na matriz
        placeData(matrix, size, dataBits);
        
        // Aplicar máscara
        applyBestMask(matrix, size);
        
        // Adicionar formato
        addFormatInfo(matrix, size, ecLevel);
        
        // Converter null para 0
        for (var i = 0; i < size; i++) {
            for (var j = 0; j < size; j++) {
                if (matrix[i][j] === null) matrix[i][j] = 0;
            }
        }
        
        return matrix;
    }
    
    function getMinVersion(byteCount, ecLevel) {
        // Capacidades simplificadas por versão
        var capacities = [
            0, 17, 32, 53, 78, 106, 134, 154, 192, 230, 271,
            321, 367, 425, 458, 520, 586, 644, 718, 792, 858
        ];
        var ecMultiplier = { L: 1, M: 0.8, Q: 0.6, H: 0.45 };
        var mult = ecMultiplier[ecLevel] || 0.8;
        
        for (var v = 1; v <= 20; v++) {
            if (capacities[v] * mult >= byteCount) return v;
        }
        return 20;
    }
    
    function addFinderPattern(matrix, row, col) {
        for (var r = -1; r <= 7; r++) {
            for (var c = -1; c <= 7; c++) {
                var mr = row + r;
                var mc = col + c;
                if (mr < 0 || mc < 0 || mr >= matrix.length || mc >= matrix.length) continue;
                
                if (r === -1 || r === 7 || c === -1 || c === 7) {
                    matrix[mr][mc] = 0; // Separator
                } else if ((r === 0 || r === 6) || (c === 0 || c === 6) || (r >= 2 && r <= 4 && c >= 2 && c <= 4)) {
                    matrix[mr][mc] = 1;
                } else {
                    matrix[mr][mc] = 0;
                }
            }
        }
    }
    
    function addAlignmentPattern(matrix, centerRow, centerCol) {
        for (var r = -2; r <= 2; r++) {
            for (var c = -2; c <= 2; c++) {
                var mr = centerRow + r;
                var mc = centerCol + c;
                if (mr < 0 || mc < 0 || mr >= matrix.length || mc >= matrix.length) continue;
                if (Math.abs(r) === 2 || Math.abs(c) === 2 || (r === 0 && c === 0)) {
                    matrix[mr][mc] = 1;
                } else {
                    matrix[mr][mc] = 0;
                }
            }
        }
    }
    
    function getAlignmentPositions(version) {
        if (version === 1) return [];
        var intervals = Math.floor(version / 7) + 1;
        var size = version * 4 + 17;
        var positions = [6];
        var step = Math.ceil((size - 13) / (intervals * 2)) * 2;
        if (step === 0) step = 2;
        var pos = size - 7;
        while (pos > 6) {
            positions.unshift(pos);
            pos -= step;
        }
        return positions;
    }
    
    function reserveFormatArea(matrix, size) {
        // Format info areas
        for (var i = 0; i < 9; i++) {
            if (matrix[8][i] === null) matrix[8][i] = 0;
            if (matrix[i][8] === null) matrix[i][8] = 0;
        }
        for (var i = 0; i < 8; i++) {
            if (matrix[8][size - 1 - i] === null) matrix[8][size - 1 - i] = 0;
            if (matrix[size - 1 - i][8] === null) matrix[size - 1 - i][8] = 0;
        }
    }
    
    function encodeData(bytes, version, ecLevel) {
        // Simplified encoding - mode indicator + length + data
        var bits = [];
        
        // Mode indicator (byte mode = 0100)
        bits.push(0, 1, 0, 0);
        
        // Character count
        var ccBits = version <= 9 ? 8 : 16;
        for (var i = ccBits - 1; i >= 0; i--) {
            bits.push((bytes.length >> i) & 1);
        }
        
        // Data bytes
        for (var i = 0; i < bytes.length; i++) {
            for (var j = 7; j >= 0; j--) {
                bits.push((bytes[i] >> j) & 1);
            }
        }
        
        // Terminator
        var totalBits = getDataCapacity(version, ecLevel) * 8;
        var termLen = Math.min(4, totalBits - bits.length);
        for (var i = 0; i < termLen; i++) bits.push(0);
        
        // Pad to byte boundary
        while (bits.length % 8 !== 0) bits.push(0);
        
        // Pad bytes
        var padBytes = [0xEC, 0x11];
        var padIdx = 0;
        while (bits.length < totalBits) {
            for (var j = 7; j >= 0; j--) {
                bits.push((padBytes[padIdx] >> j) & 1);
            }
            padIdx = (padIdx + 1) % 2;
        }
        
        return bits;
    }
    
    function getDataCapacity(version, ecLevel) {
        // Simplified capacity table
        var baseCapacity = version * 2 + 10;
        var ecMult = { L: 1, M: 0.85, Q: 0.7, H: 0.55 };
        return Math.floor(baseCapacity * (ecMult[ecLevel] || 0.85));
    }
    
    function placeData(matrix, size, bits) {
        var bitIdx = 0;
        var col = size - 1;
        var goingUp = true;
        
        while (col >= 0) {
            if (col === 6) col--; // Skip timing column
            
            for (var i = 0; i < size; i++) {
                var row = goingUp ? (size - 1 - i) : i;
                
                for (var c = 0; c < 2; c++) {
                    var actualCol = col - c;
                    if (actualCol < 0) continue;
                    if (matrix[row][actualCol] !== null) continue;
                    
                    if (bitIdx < bits.length) {
                        matrix[row][actualCol] = bits[bitIdx];
                        bitIdx++;
                    } else {
                        matrix[row][actualCol] = 0;
                    }
                }
            }
            
            goingUp = !goingUp;
            col -= 2;
        }
    }
    
    function applyBestMask(matrix, size) {
        // Apply mask pattern 0 (simplified)
        for (var row = 0; row < size; row++) {
            for (var col = 0; col < size; col++) {
                if (isDataModule(matrix, row, col, size)) {
                    if ((row + col) % 2 === 0) {
                        matrix[row][col] = matrix[row][col] ^ 1;
                    }
                }
            }
        }
    }
    
    function isDataModule(matrix, row, col, size) {
        // Check if module is in reserved area
        // Finder patterns
        if ((row < 9 && col < 9) || (row < 9 && col >= size - 8) || (row >= size - 8 && col < 9)) return false;
        // Timing
        if (row === 6 || col === 6) return false;
        return true;
    }
    
    function addFormatInfo(matrix, size, ecLevel) {
        var formatBits = getFormatBits(ecLevel, 0); // Mask 0
        for (var i = 0; i < 15; i++) {
            var bit = (formatBits >> (14 - i)) & 1;
            // Horizontal
            if (i < 6) matrix[8][i] = bit;
            else if (i === 6) matrix[8][7] = bit;
            else if (i === 7) matrix[8][8] = bit;
            else if (i === 8) matrix[7][8] = bit;
            else matrix[14 - i][8] = bit;
            
            // Vertical
            if (i < 6) matrix[i][8] = bit;
            else if (i === 6) matrix[7][8] = bit;
            else if (i === 7) matrix[8][8] = bit;
            else if (i === 8) matrix[8][7] = bit;
            else matrix[8][size - 15 + i] = bit;
        }
    }
    
    function getFormatBits(ecLevel, mask) {
        var ecBits = { L: 1, M: 0, Q: 3, H: 2 };
        var data = ((ecBits[ecLevel] || 0) << 3) | mask;
        var format = data << 10;
        var gen = 0x537; // Generator polynomial
        var tmp = format;
        for (var i = 4; i >= 0; i--) {
            if (tmp & (1 << (i + 10))) {
                tmp ^= gen << i;
            }
        }
        format = ((data << 10) | tmp) ^ 0x5412; // XOR mask
        return format;
    }
    
    return { generate: generate };
})();

// Estado da aplicação
var state = {
    ecLevel: 'M',
    size: 300,
    margin: 4,
    darkColor: '#000000',
    lightColor: '#ffffff',
    currentCanvas: null
};

// Event listeners
document.getElementById('content').addEventListener('input', function() {
    document.getElementById('char-count').textContent = this.value.length;
    clearTimeout(window.generateTimeout);
    window.generateTimeout = setTimeout(generateQR, 300);
});

document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.key === 'v') {
        // Permitir colar normal
    }
});

function clearContent() {
    document.getElementById('content').value = '';
    document.getElementById('char-count').textContent = '0';
    document.getElementById('qr-area').innerHTML = '<div class="empty-state"><div class="icon">⬛</div><p>Digite ou cole algo para gerar o QR Code</p><p class="hint">Ctrl+V para colar rapidamente</p></div>';
    document.getElementById('action-buttons').style.display = 'none';
    document.getElementById('info-grid').style.display = 'none';
}

function pasteFromClipboard() {
    // HTA não tem acesso direto à área de transferência via JS
    // O usuário deve usar Ctrl+V
    var textarea = document.getElementById('content');
    textarea.focus();
    alert('Use Ctrl+V para colar o conteúdo.');
}

function setECLevel(level) {
    state.ecLevel = level;
    var buttons = document.querySelectorAll('.ec-btn');
    for (var i = 0; i < buttons.length; i++) {
        buttons[i].className = 'ec-btn' + (buttons[i].getAttribute('data-level') === level ? ' active' : '');
    }
    generateQR();
}

function updateSize() {
    state.size = parseInt(document.getElementById('size-slider').value);
    document.getElementById('size-value').textContent = state.size;
    generateQR();
}

function updateMargin() {
    state.margin = parseInt(document.getElementById('margin-slider').value);
    document.getElementById('margin-value').textContent = state.margin;
    generateQR();
}

function updateColors() {
    state.darkColor = document.getElementById('dark-color').value;
    state.lightColor = document.getElementById('light-color').value;
    document.getElementById('dark-hex').value = state.darkColor;
    document.getElementById('light-hex').value = state.lightColor;
    generateQR();
}

function updateDarkHex() {
    var val = document.getElementById('dark-hex').value;
    if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
        state.darkColor = val;
        document.getElementById('dark-color').value = val;
        generateQR();
    }
}

function updateLightHex() {
    var val = document.getElementById('light-hex').value;
    if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
        state.lightColor = val;
        document.getElementById('light-color').value = val;
        generateQR();
    }
}

function applyTheme(dark, light) {
    state.darkColor = dark;
    state.lightColor = light;
    document.getElementById('dark-color').value = dark;
    document.getElementById('light-color').value = light;
    document.getElementById('dark-hex').value = dark;
    document.getElementById('light-hex').value = light;
    generateQR();
}

function applyTemplate(type) {
    var templates = {
        url: 'https://',
        wifi: 'WIFI:T:WPA;S:NomeDaRede;P:Senha;;',
        email: 'mailto:email@exemplo.com',
        phone: 'tel:+5511999999999',
        vcard: 'BEGIN:VCARD\nVERSION:3.0\nFN:Nome\nTEL:+5511999999999\nEMAIL:email@exemplo.com\nEND:VCARD',
        sms: 'smsto:+5511999999999:Mensagem'
    };
    document.getElementById('content').value = templates[type] || '';
    document.getElementById('char-count').textContent = document.getElementById('content').value.length;
    generateQR();
}

function generateQR() {
    var text = document.getElementById('content').value;
    if (!text.trim()) {
        clearContent();
        return;
    }
    
    try {
        var canvas = QRCodeLib.generate(text, {
            ecLevel: state.ecLevel,
            size: state.size,
            margin: state.margin,
            darkColor: state.darkColor,
            lightColor: state.lightColor
        });
        
        if (canvas) {
            state.currentCanvas = canvas;
            var qrArea = document.getElementById('qr-area');
            qrArea.innerHTML = '';
            var container = document.createElement('div');
            container.className = 'qr-container';
            container.style.background = state.lightColor;
            container.appendChild(canvas);
            qrArea.appendChild(container);
            
            document.getElementById('action-buttons').style.display = 'flex';
            document.getElementById('info-grid').style.display = 'grid';
            
            // Update info
            var ecLabels = { L: 'Baixa (L)', M: 'Média (M)', Q: 'Quartil (Q)', H: 'Alta (H)' };
            var ecPercents = { L: '7%', M: '15%', Q: '25%', H: '30%' };
            document.getElementById('info-ec').textContent = ecLabels[state.ecLevel];
            document.getElementById('info-size').textContent = state.size + '×' + state.size;
            document.getElementById('info-chars').textContent = text.length;
            document.getElementById('info-protection').textContent = ecPercents[state.ecLevel];
        }
    } catch (e) {
        console.error('Erro ao gerar QR:', e);
    }
}

function downloadQR() {
    if (!state.currentCanvas) return;
    try {
        var dataUrl = state.currentCanvas.toDataURL('image/png');
        // Em HTA, podemos salvar usando ADO
        var fileName = 'qrcode-' + new Date().getTime() + '.png';
        
        // Método 1: Abrir em nova janela para salvar
        var win = window.open('', '_blank');
        if (win) {
            win.document.write('<html><head><title>Salvar QR Code</title></head><body style="margin:0;background:#333;display:flex;align-items:center;justify-content:center;height:100vh;flex-direction:column;color:#fff;font-family:Arial">');
            win.document.write('<h2>QR Code gerado com sucesso!</h2>');
            win.document.write('<p>Clique com o botão direito na imagem e selecione "Salvar imagem como..."</p>');
            win.document.write('<img src="' + dataUrl + '" style="max-width:90%;border:4px solid #fff;border-radius:8px">');
            win.document.write('</body></html>');
            win.document.close();
        } else {
            alert('Para salvar: clique com botão direito no QR Code e selecione "Salvar imagem como..."');
        }
    } catch (e) {
        alert('Erro ao salvar: ' + e.message);
    }
}

function copyQR() {
    alert('Para copiar a imagem:\n1. Clique com botão direito no QR Code\n2. Selecione "Copiar imagem"\n3. Cole onde desejar (Ctrl+V)');
}

// Gerar QR inicial se houver conteúdo
window.onload = function() {
    document.getElementById('content').focus();
};
</script>
</body>
</html>

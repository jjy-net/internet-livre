<html>
<head>
<title>Gerador de QR Code</title>
<HTA:APPLICATION 
    ID="QRCodeApp"
    APPLICATIONNAME="Gerador de QR Code"
    BORDER="thin"
    CAPTION="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    NAVIGABLE="no"
    CONTEXTMENU="no"
    SELECTION="no"
    INNERBORDER="no"
/>
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    font-family: 'Segoe UI', Tahoma, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    height: 100vh;
    overflow: hidden;
}
.app { display: flex; flex-direction: column; height: 100vh; padding: 15px; }
.header {
    background: white;
    border-radius: 12px;
    padding: 15px 20px;
    margin-bottom: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 15px;
}
.logo-icon {
    width: 45px; height: 45px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; color: white;
}
.header h1 { font-size: 20px; color: #667eea; }
.header p { font-size: 12px; color: #666; margin-top: 2px; }
.main { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 15px; overflow: hidden; }
.panel {
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    overflow-y: auto;
}
.panel::-webkit-scrollbar { width: 6px; }
.panel::-webkit-scrollbar-thumb { background: #667eea; border-radius: 3px; }
.section-title { font-size: 16px; font-weight: 600; color: #667eea; margin-bottom: 12px; }
textarea {
    width: 100%; height: 100px;
    border: 2px solid #e0e0e0; border-radius: 8px;
    padding: 10px; font-size: 13px;
    font-family: 'Courier New', monospace;
    resize: none; outline: none;
}
textarea:focus { border-color: #667eea; }
.btn {
    padding: 10px 20px; border: none; border-radius: 8px;
    font-size: 14px; font-weight: 600; cursor: pointer;
    margin: 4px; transition: all 0.2s;
}
.btn-primary { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(102,126,234,0.4); }
.btn-secondary { background: #f0f0f0; color: #333; }
.btn-secondary:hover { background: #e0e0e0; }
.ec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 15px; }
.ec-btn {
    padding: 10px; background: #f8f9fa;
    border: 2px solid #e0e0e0; border-radius: 8px;
    cursor: pointer; text-align: left; transition: all 0.2s;
}
.ec-btn:hover { border-color: #667eea; }
.ec-btn.active { background: linear-gradient(135deg, #667eea, #764ba2); color: white; border-color: transparent; }
.ec-btn .level { font-weight: 600; font-size: 13px; }
.ec-btn .desc { font-size: 10px; opacity: 0.8; margin-top: 2px; }
label { display: block; font-size: 12px; font-weight: 500; color: #666; margin-bottom: 6px; }
input[type="range"] {
    width: 100%; height: 5px; background: #e0e0e0;
    border-radius: 3px; outline: none; -webkit-appearance: none;
}
input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 16px; height: 16px;
    background: #667eea; border-radius: 50%; cursor: pointer;
}
.color-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 8px; }
.color-input {
    display: flex; align-items: center; gap: 8px;
    background: #f8f9fa; border: 2px solid #e0e0e0;
    border-radius: 6px; padding: 6px;
}
input[type="color"] {
    width: 32px; height: 32px; border: none;
    background: transparent; cursor: pointer; border-radius: 4px;
}
.themes { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.theme-btn {
    padding: 6px 10px; background: #f8f9fa;
    border: 2px solid #e0e0e0; border-radius: 6px;
    cursor: pointer; font-size: 11px;
    display: flex; align-items: center; gap: 4px;
    transition: all 0.2s;
}
.theme-btn:hover { border-color: #667eea; }
.theme-preview { width: 16px; height: 16px; border-radius: 3px; border: 1px solid #ddd; }
.templates { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px; }
.template-btn {
    padding: 12px 8px; background: #f8f9fa;
    border: 2px solid #e0e0e0; border-radius: 8px;
    cursor: pointer; text-align: center; transition: all 0.2s;
}
.template-btn:hover { border-color: #667eea; background: #f0f4ff; }
.template-btn .icon { font-size: 20px; }
.template-btn .label { font-size: 11px; color: #666; margin-top: 3px; }
.qr-display {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    min-height: 250px;
}
.qr-container {
    background: white; border-radius: 12px;
    padding: 20px;
    box-shadow: 0 8px 30px rgba(102,126,234,0.3);
    display: inline-block;
}
#qrcode { display: block; }
.empty-state { text-align: center; color: #999; padding: 40px 20px; }
.empty-state .icon { font-size: 60px; opacity: 0.3; margin-bottom: 15px; }
.empty-state p { font-size: 14px; margin-bottom: 8px; }
.action-buttons { display: flex; gap: 8px; margin-top: 15px; flex-wrap: wrap; justify-content: center; }
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 15px; }
.info-item { background: #f8f9fa; border-radius: 8px; padding: 10px; }
.info-item .label { font-size: 10px; color: #999; }
.info-item .value { font-size: 13px; font-weight: 600; color: #667eea; margin-top: 2px; }
.alert { padding: 10px 14px; border-radius: 6px; margin-bottom: 10px; font-size: 12px; display: none; }
.alert-error { background: #fee; color: #c33; border: 1px solid #fcc; }
.alert-success { background: #efe; color: #3c3; border: 1px solid #cfc; }
</style>
</head>
<body>
<div class="app">
    <div class="header">
        <div class="logo-icon">⬛</div>
        <div>
            <h1>Gerador de QR Code</h1>
            <p>✅ 100% Offline - Programa Portable</p>
        </div>
    </div>
    
    <div class="main">
        <div class="panel">
            <div class="section-title">📝 Digite o Conteúdo</div>
            <div id="alert" class="alert"></div>
            <textarea id="content" placeholder="Digite ou cole: texto, link, senha, etc..."></textarea>
            
            <div style="margin-top: 10px;">
                <button class="btn btn-secondary" onclick="limpar()">🗑️ Limpar</button>
                <button class="btn btn-primary" onclick="gerar()">⚡ Gerar QR Code</button>
            </div>
            
            <div style="margin-top: 15px;">
                <div class="section-title">⚙️ Configurações</div>
                
                <label>Correção de Erro</label>
                <div class="ec-grid">
                    <div class="ec-btn" data-level="L" onclick="setEC('L')">
                        <div class="level">Baixa (L)</div>
                        <div class="desc">~7% recuperação</div>
                    </div>
                    <div class="ec-btn active" data-level="M" onclick="setEC('M')">
                        <div class="level">Média (M)</div>
                        <div class="desc">~15% recuperação</div>
                    </div>
                    <div class="ec-btn" data-level="Q" onclick="setEC('Q')">
                        <div class="level">Alta (Q)</div>
                        <div class="desc">~25% recuperação</div>
                    </div>
                    <div class="ec-btn" data-level="H" onclick="setEC('H')">
                        <div class="level">Máxima (H)</div>
                        <div class="desc">~30% recuperação</div>
                    </div>
                </div>
                
                <label>Tamanho: <span id="size-value">300</span>px</label>
                <input type="range" id="size" min="150" max="500" value="300" step="25" oninput="document.getElementById('size-value').textContent=this.value">
                
                <label style="margin-top: 10px;">Margem: <span id="margin-value">4</span></label>
                <input type="range" id="margin" min="0" max="10" value="4" step="1" oninput="document.getElementById('margin-value').textContent=this.value">
                
                <label style="margin-top: 10px;">Cores</label>
                <div class="color-row">
                    <div class="color-input">
                        <input type="color" id="dark-color" value="#000000">
                        <span style="font-size:11px; color:#666;">QR</span>
                    </div>
                    <div class="color-input">
                        <input type="color" id="light-color" value="#ffffff">
                        <span style="font-size:11px; color:#666;">Fundo</span>
                    </div>
                </div>
                <div class="themes">
                    <div class="theme-btn" onclick="applyTheme('#000000','#ffffff')"><div class="theme-preview" style="background:linear-gradient(135deg,#000 50%,#fff 50%)"></div>Clássico</div>
                    <div class="theme-btn" onclick="applyTheme('#2d1b69','#f0e6ff')"><div class="theme-preview" style="background:linear-gradient(135deg,#2d1b69 50%,#f0e6ff 50%)"></div>Roxo</div>
                    <div class="theme-btn" onclick="applyTheme('#004d40','#e0f2f1')"><div class="theme-preview" style="background:linear-gradient(135deg,#004d40 50%,#e0f2f1 50%)"></div>Verde</div>
                    <div class="theme-btn" onclick="applyTheme('#b71c1c','#ffebee')"><div class="theme-preview" style="background:linear-gradient(135deg,#b71c1c 50%,#ffebee 50%)"></div>Vermelho</div>
                    <div class="theme-btn" onclick="applyTheme('#0d47a1','#e3f2fd')"><div class="theme-preview" style="background:linear-gradient(135deg,#0d47a1 50%,#e3f2fd 50%)"></div>Azul</div>
                </div>
            </div>
            
            <div style="margin-top: 15px;">
                <div class="section-title">📋 Modelos Prontos</div>
                <div class="templates">
                    <div class="template-btn" onclick="applyTemplate('url')"><div class="icon">🔗</div><div class="label">Link</div></div>
                    <div class="template-btn" onclick="applyTemplate('wifi')"><div class="icon">📶</div><div class="label">Wi-Fi</div></div>
                    <div class="template-btn" onclick="applyTemplate('email')"><div class="icon">📧</div><div class="label">E-mail</div></div>
                    <div class="template-btn" onclick="applyTemplate('phone')"><div class="icon">📱</div><div class="label">Telefone</div></div>
                    <div class="template-btn" onclick="applyTemplate('vcard')"><div class="icon">👤</div><div class="label">Contato</div></div>
                    <div class="template-btn" onclick="applyTemplate('sms')"><div class="icon">💬</div><div class="label">SMS</div></div>
                </div>
            </div>
        </div>
        
        <div class="panel">
            <div class="section-title">📱 Seu QR Code</div>
            <div class="qr-display">
                <div id="qr-area">
                    <div class="empty-state">
                        <div class="icon">🔲</div>
                        <p>Digite algo e clique em "Gerar QR Code"</p>
                    </div>
                </div>
            </div>
            <div class="action-buttons" id="action-buttons" style="display:none">
                <button class="btn btn-primary" onclick="salvar()">💾 Salvar PNG</button>
            </div>
            <div class="info-grid" id="info-grid" style="display:none">
                <div class="info-item"><div class="label">Correção</div><div class="value" id="info-ec">Média (M)</div></div>
                <div class="info-item"><div class="label">Tamanho</div><div class="value" id="info-size">300×300</div></div>
                <div class="info-item"><div class="label">Caracteres</div><div class="value" id="info-chars">0</div></div>
                <div class="info-item"><div class="label">Proteção</div><div class="value" id="info-protection">15%</div></div>
            </div>
        </div>
    </div>
</div>

<script>
// ============================================
// QR Code Generator - Biblioteca Completa
// ============================================
var qrcode=function(){var r=function(r,e){if(void 0===r.length)throw new Error(r.length+"/"+e);for(var t=0;t<r.length&&0==r[t];)t++;this.num=new Array(r.length-t+e);for(var n=0;n<r.length-t;n++)this.num[n]=r[n+t]};r.prototype={get:function(r){return this.num[r]},getLength:function(){return this.num.length},multiply:function(e){for(var t=new Array(this.getLength()+e.getLength()-1),n=0;n<this.getLength();n++)for(var o=0;o<e.getLength();o++)t[n+o]^=a.gexp(a.glog(this.get(n))+a.glog(e.get(o)));return new r(t,0)},mod:function(e){if(this.getLength()-e.getLength()<0)return this;for(var t=a.glog(this.get(0))-a.glog(e.get(0)),n=new Array(this.getLength()),o=0;o<this.getLength();o++)n[o]=this.get(o);for(o=0;o<e.getLength();o++)n[o]^=a.gexp(a.glog(e.get(o))+t);return new r(n,0).mod(e)}};var a={glog:function(r){if(r<1)throw new Error("glog("+r+")");return a.LOG_TABLE[r]},gexp:function(r){for(;r<0;)r+=255;for(;r>=256;)r-=255;return a.EXP_TABLE[r]},EXP_TABLE:new Array(256),LOG_TABLE:new Array(256)};for(var t=0;t<8;t++)a.EXP_TABLE[t]=1<<t;for(t=8;t<256;t++)a.EXP_TABLE[t]=a.EXP_TABLE[t-4]^a.EXP_TABLE[t-5]^a.EXP_TABLE[t-6]^a.EXP_TABLE[t-8];for(t=0;t<255;t++)a.LOG_TABLE[a.EXP_TABLE[t]]=t;function n(r,e){this.typeNumber=r,this.errorCorrectLevel=e,this.modules=null,this.moduleCount=0,this.dataCache=null,this.dataList=[]}n.prototype={addData:function(r){var e=new function(r){this.mode=4,this.data=r,this.parsedData=[];for(var e=[],t=0,n=this.data.length;t<n;t++){var o=this.data.charCodeAt(t);o>65536?(e[0]=0xf0|(o>>>18&7),e[1]=0x80|(o>>>12&63),e[2]=0x80|(o>>>6&63),e[3]=0x80|(63&o),t+=3):o>2048?(e[0]=0xe0|(o>>>12&15),e[1]=0x80|(o>>>6&63),e[2]=0x80|(63&o),t+=2):o>127?(e[0]=0xc0|o>>>6&31,e[1]=0x80|(63&o),t++):e[0]=o,this.parsedData.push(e)}this.parsedData=Array.prototype.concat.apply([],this.parsedData),this.parsedData.length!=this.data.length&&(this.parsedData.unshift(191),this.parsedData.unshift(187),this.parsedData.unshift(239))}(r);this.dataList.push(e),this.dataCache=null},isDark:functi
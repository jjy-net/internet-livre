// ============================================
// Código da Aplicação
// ============================================
var state = { ecLevel: 'M', size: 300, margin: 4, darkColor: '#000000', lightColor: '#ffffff' };

function showAlert(msg, type) {
    var a = document.getElementById('alert');
    a.innerHTML = msg;
    a.className = 'alert alert-' + (type || 'error');
    a.style.display = 'block';
    setTimeout(function() { a.style.display = 'none'; }, 3000);
}

function limpar() {
    document.getElementById('content').value = '';
    document.getElementById('qr-area').innerHTML = '<div class="empty-state"><div class="icon">🔲</div><p>Digite algo e clique em "Gerar QR Code"</p></div>';
    document.getElementById('action-buttons').style.display = 'none';
    document.getElementById('info-grid').style.display = 'none';
}

function setEC(level) {
    state.ecLevel = level;
    var buttons = document.querySelectorAll('.ec-btn');
    for (var i = 0; i < buttons.length; i++) {
        buttons[i].className = 'ec-btn' + (buttons[i].getAttribute('data-level') === level ? ' active' : '');
    }
}

function applyTheme(dark, light) {
    state.darkColor = dark;
    state.lightColor = light;
    document.getElementById('dark-color').value = dark;
    document.getElementById('light-color').value = light;
}

function applyTemplate(type) {
    var templates = {
        url: 'https://',
        wifi: 'WIFI:T:WPA;S:NomeDaRede;P:Senha;;',
        email: 'mailto:email@exemplo.com',
        phone: 'tel:+5511999999999',
        vcard: 'BEGIN:VCARD\nVERSION:3.0\nFN:Nome\nTEL:+5511999999999\nEMAIL:email@exemplo.com\nEND:VCARD',
        sms: 'smsto:+5511999999999:Mensagem'
    };
    document.getElementById('content').value = templates[type] || '';
}

function gerar() {
    var text = document.getElementById('content').value;
    if (!text || !text.length) { showAlert('Digite algo primeiro!'); return; }
    
    try {
        state.size = parseInt(document.getElementById('size').value);
        state.margin = parseInt(document.getElementById('margin').value);
        state.darkColor = document.getElementById('dark-color').value;
        state.lightColor = document.getElementById('light-color').value;
        
        var qr = qrcode(text, state.ecLevel);
        var moduleCount = qr.getModuleCount();
        var cellSize = state.size / (moduleCount + state.margin * 2);
        
        var canvas = document.createElement('canvas');
        canvas.width = state.size;
        canvas.height = state.size;
        canvas.id = 'qrcode';
        var ctx = canvas.getContext('2d');
        
        ctx.fillStyle = state.lightColor;
        ctx.fillRect(0, 0, state.size, state.size);
        
        ctx.fillStyle = state.darkColor;
        for (var row = 0; row < moduleCount; row++) {
            for (var col = 0; col < moduleCount; col++) {
                if (qr.isDark(row, col)) {
                    var x = (col + state.margin) * cellSize;
                    var y = (row + state.margin) * cellSize;
                    ctx.fillRect(Math.round(x), Math.round(y), Math.ceil(cellSize), Math.ceil(cellSize));
                }
            }
        }
        
        var qrArea = document.getElementById('qr-area');
        qrArea.innerHTML = '';
        var container = document.createElement('div');
        container.className = 'qr-container';
        container.style.background = state.lightColor;
        container.appendChild(canvas);
        qrArea.appendChild(container);
        
        document.getElementById('action-buttons').style.display = 'flex';
        document.getElementById('info-grid').style.display = 'grid';
        
        var ecLabels = {L:'Baixa (L)',M:'Média (M)',Q:'Alta (Q)',H:'Máxima (H)'};
        var ecPercents = {L:'7%',M:'15%',Q:'25%',H:'30%'};
        document.getElementById('info-ec').innerHTML = ecLabels[state.ecLevel];
        document.getElementById('info-size').innerHTML = state.size + '×' + state.size;
        document.getElementById('info-chars').innerHTML = text.length;
        document.getElementById('info-protection').innerHTML = ecPercents[state.ecLevel];
        
        showAlert('✅ QR Code gerado com sucesso!', 'success');
    } catch (e) {
        showAlert('Erro: ' + e.message);
    }
}

function salvar() {
    var canvas = document.getElementById('qrcode');
    if (!canvas) { showAlert('Gere um QR Code primeiro!'); return; }
    
    try {
        var dataUrl = canvas.toDataURL('image/png');
        
        // Usar FileSystemObject do HTA para salvar
        var fso = new ActiveXObject('Scripting.FileSystemObject');
        var shell = new ActiveXObject('Shell.Application');
        var folder = shell.BrowseForFolder(0, 'Escolha onde salvar o QR Code', 0);
        
        if (folder) {
            var path = folder.Self.Path + '\\qrcode-' + (new Date()).getTime() + '.png';
            
            // Converter base64 para bytes
            var base64Data = dataUrl.split(',')[1];
            var byteString = atob(base64Data);
            var byte_array = new VBArray(byteString).toArray ? byteString : [];
            
            // Salvar usando ADODB.Stream
            var stream = new ActiveXObject('ADODB.Stream');
            stream.Type = 1; // adTypeBinary
            stream.Open();
            
            // Converter base64 para binário
            var xml = new ActiveXObject('MSXML2.DOMDocument');
            var elem = xml.createElement('tmp');
            elem.dataType = 'bin.base64';
            elem.text = base64Data;
            stream.write(elem.nodeTypedValue);
            
            stream.SaveToFile(path, 2); // adSaveCreateOverWrite
            stream.Close();
            
            showAlert('✅ Salvo em: ' + path, 'success');
        }
    } catch (e) {
        // Fallback: abrir em nova janela para salvar
        try {
            var win = window.open('', '_blank');
            win.document.write('<html><head><title>Salvar QR Code</title></head><body style="margin:0;background:#333;display:flex;align-items:center;justify-content:center;height:100vh;flex-direction:column;color:#fff;font-family:Arial">');
            win.document.write('<h2>Clique com botão direito na imagem e selecione "Salvar imagem como..."</h2>');
            win.document.write('<img src="' + dataUrl + '" style="max-width:90%;border:4px solid #fff;border-radius:8px;margin-top:20px">');
            win.document.write('</body></html>');
        } catch (e2) {
            showAlert('Erro ao salvar. Tente outro método.');
        }
    }
}

// Ajustar tamanho da janela
window.onload = function() {
    window.resizeTo(1100, 750);
    window.moveTo((screen.width - 1100) / 2, (screen.height - 750) / 2);
};
</script>
</body>
</html>

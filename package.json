{
  "name": "jyy",
  "version": "2.0.0",
  "description": "Jyy - Suite Offline & P2P",
  "author": "Jyy Team",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/start.js",
    "preview": "vite preview",
    "server": "node server/start.js",
    "typecheck": "tsc --noEmit",
    "test": "node tests/server-test.mjs",
    "electron": "electron electron/main.cjs",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron electron/main.cjs\"",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "deploy:nsite": "npm run build && nsyte deploy ./dist --fallback=/index.html"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "@types/qrcode": "^1.5.6",
    "canvas-confetti": "^1.9.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.16.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.294.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0",
    "wait-on": "^9.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "cacheable-request": "^10.2.7",
    "http-cache-semantics": "^4.2.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.jyy.app",
    "productName": "Jyy",
    "copyright": "Copyright © 2026 Jyy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.svg",
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable.exe"
    },
    "asar": true,
    "compression": "maximum"
  }
}
